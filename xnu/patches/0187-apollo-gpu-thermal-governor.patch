+	if (!kept.on || level < 1 || level >= GPU_LEVELS) {
+		return false;
+	}
+	if (gpu_level_khz[level] == kept.khz) {
+		return true;
+	}
+	perf_vote[0] = 0;
+	perf_vote[1] = 1;
+	perf_vote[2] = level;
+	perf_vote[3] = 0;
+	if (!hfi_send("a new GPU speed (thermal)", HFI_GX_BW_PERF_VOTE, perf_vote, 4)) {
+		return false;
+	}
+	kept.khz = gpu_level_khz[level];
+	return true;
+}
